PORT=3000
HOST=0.0.0.0
AUTH_USERS=your-admin-id:replace-with-a-strong-password
AUTH_ADMIN_USERS=your-admin-id
AUTH_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_PROFILES={"your-admin-id":{"name":"Admin","institution":"Your institution"}}
SESSION_TTL_SECONDS=28800
REMEMBER_TTL_SECONDS=2592000
ADMIN_EMAIL=admin@example.com
CESIUM_ION_TOKEN=your-restricted-cesium-ion-public-token
# MongoDB Atlas untuk profil & forum diskusi. Kosongkan bila belum dipakai.
# Tambahkan nama database (mis. vulcaneos) sebelum tanda tanya.
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxxx.mongodb.net/vulcaneos?retryWrites=true&w=majority&authSource=admin
# Opsional: paksa nama database bila tidak ditulis pada URI.
# MONGODB_DB=vulcaneos
